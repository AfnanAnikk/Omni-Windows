# ==========================================
# ScreenWhisper Configuration
# ==========================================

# Your Google Gemini API Key (Get a free key at https://aistudio.google.com)
GEMINI_API_KEY=

# Model to use (gemini-2.0-flash is ultra-fast with native audio + vision support)
GEMINI_MODEL=gemini-2.0-flash

# Global Hotkey (Default: Ctrl + Option + Space)
# Examples: <ctrl>+<alt>+<space>, <cmd>+<shift>+j, <f8>
HOTKEY=<ctrl>+<alt>+<space>

# Trigger Mode: "toggle" (tap to start, tap again to answer) or "push_to_talk" (hold while speaking)
TRIGGER_MODE=toggle

# Subtle macOS audio cues on start/finish (true / false)
PLAY_SOUNDS=true

# Audio input device for ffmpeg (default: ":0" is internal microphone)
AUDIO_DEVICE=:0

# Max recording length safeguard in seconds
MAX_RECORD_SECONDS=30
